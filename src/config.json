      "Seed Initialization Value Bit 3",
      "Seed Initialization Value Bit 4",
      "Seed Initialization Value Bit 5",
      "Seed Initialization Value Bit 6"
    ],
    "uo_out": [
      "Parallel Random Output Bit 0",
      "Parallel Random Output Bit 1",
      "Parallel Random Output Bit 2",
      "Parallel Random Output Bit 3",
      "Parallel Random Output Bit 4",
      "Parallel Random Output Bit 5",
      "Parallel Random Output Bit 6",
      "Parallel Random Output Bit 7"
    ],
    "uio_in": [
      "Unused",
      "Unused",
      "Unused",
      "Unused",
      "Unused",
      "Unused",
      "Unused",
      "Unused"
    ],
    "uio_out": [
      "Serial Data Bit Stream Output",
      "Unused",
      "Unused",
      "Unused",
      "Unused",
      "Unused",
      "Unused",
      "Unused"
    ],
    "uio_oe": [
